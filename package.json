{
  "name": "@spiel-ein-spiel/mystery",
  "version": "0.1.0",
  "description": "Presentation-independent, blind-first closed-system deduction engine",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "simulate": "node src/cli.ts",
    "build": "node scripts/build.mjs",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlindAnatomist/spiel-ein-spiel-clue.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/BlindAnatomist/spiel-ein-spiel-clue/issues"
  },
  "homepage": "https://github.com/BlindAnatomist/spiel-ein-spiel-clue#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.51.1",
    "@types/node": "26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./referee": "./src/referee.ts",
    "./simulation": "./src/simulation.ts",
    "./content": "./src/content.ts"
  },
  "overrides": {
    "playwright-core": "1.51.1"
  }
}
